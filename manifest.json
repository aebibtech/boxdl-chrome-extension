{
    "manifest_version": 3,
    "name": "Box.com Downloader",
    "version": "1.1",
    "description": "Capture and download PDFs or internal files based on network requests.",
    "permissions": [
      "scripting",
      "downloads",
      "activeTab"
    ],
    "host_permissions": [
      "<all_urls>"
    ],
    "action": {
      "default_icon": {
        "16": "icon.png",
        "48": "icon.png",
        "128": "icon.png"
      }
    },
    "background": {
      "service_worker": "background.js"
    },
    "content_scripts": [
      {
        "matches": [
        	"*://*.box.com/*",
        	"*://*.boxcloud.com/*"
        ],
        "js": ["content.js"],
        "run_at": "document_idle"
      }
    ],
    "icons": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  }